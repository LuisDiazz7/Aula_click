VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_key_publica

# El Tutor IA llama a Gemini desde una Supabase Edge Function (supabase/functions/tutor).
# La clave de Gemini NO va en el frontend ni en el bundle de Vite. Configúrala como
# secreto del servidor:
#   supabase secrets set GEMINI_API_KEY=tu_clave_de_gemini
# Opcional (por defecto: gemini-3.5-flash-lite; hay fallback a gemini-flash-lite-latest):
#   supabase secrets set GEMINI_MODEL=gemini-3.5-flash-lite
